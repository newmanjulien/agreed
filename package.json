{
	"name": "agreed",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run check && node scripts/clean-vercel-output.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run validate:contract",
		"test": "node --test tests/*.test.ts",
		"validate:contract": "node scripts/validate-contract.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"parse5": "^8.0.1",
		"phosphor-svelte": "^3.1.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
